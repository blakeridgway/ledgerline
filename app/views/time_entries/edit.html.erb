<% content_for :title, "Edit time entry · time_logix" %>

<div class="page-head">
  <div>
    <h1>Edit time entry</h1>
    <div class="page-head__meta">
      <%= @time_entry.client.display_name %> · logged <%= date_label(@time_entry.created_at.to_date) %>
    </div>
  </div>
  <div class="page-actions">
    <%= link_to "Back to time", time_entries_path, class: "btn" %>
  </div>
</div>

<div class="stack" style="max-width: 720px">
  <div class="card">
    <div class="card__body">
      <%= render "shared/time_entry_form",
            time_entry: @time_entry,
            clients: @clients,
            submit_label: "Save entry" %>
    </div>
  </div>

  <div class="card">
    <div class="card__header"><h3>Danger zone</h3></div>
    <div class="card__body">
      <p class="small muted">Deleting a time entry is permanent. Entries already on an invoice are not listed here.</p>
      <%= button_to "Delete this entry", time_entry_path(@time_entry), method: :delete,
            class: "btn btn--danger",
            form: { data: { turbo_confirm: "Delete this time entry? This cannot be undone." } } %>
    </div>
  </div>
</div>
