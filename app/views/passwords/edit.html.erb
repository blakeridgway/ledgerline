<div class="auth">
  <div class="auth__card">
    <div class="auth__brand">
      <span class="brand__mark">TL</span>
      <strong style="font-size:1.05rem">time_logix</strong>
    </div>

    <div class="card">
      <div class="card__body">
        <h1>Choose a new password</h1>

        <%= render "shared/flash" %>

        <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
          <div class="field">
            <%= form.label :password, "New password" %>
            <%= form.password_field :password, required: true, autofocus: true,
                  autocomplete: "new-password", maxlength: 72 %>
          </div>

          <div class="field">
            <%= form.label :password_confirmation, "Repeat new password" %>
            <%= form.password_field :password_confirmation, required: true,
                  autocomplete: "new-password", maxlength: 72 %>
          </div>

          <%= form.submit "Save password", class: "btn btn--primary btn--block" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
